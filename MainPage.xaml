<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SubtitleMaster.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SubtitleMaster.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,2,24,18" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <!-- Top Actions Bar (No duplicate title on home page: Windows TitleBar already has it) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: CLI Status Pill & Debug Mode Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border HorizontalAlignment="Left"
                        CornerRadius="12" Padding="10,4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="CliStatusDot" Width="8" Height="8" Fill="#107C41" VerticalAlignment="Center" />
                        <TextBlock x:Name="CliStatusText" Text="CLI 服务正常可用" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Click="OnRefreshCliClicked" Style="{ThemeResource SubtleButtonStyle}" Padding="4,2" Margin="4,0,0,0" ToolTipService.ToolTip="重新检测 CLI 状态">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Debug Mode Active Badge -->
                <Border x:Name="DebugModeBadgeBorder"
                        Visibility="Collapsed"
                        CornerRadius="12" Padding="8,3"
                        Background="#FFF3CD"
                        BorderBrush="#FFEEBA"
                        BorderThickness="1"
                        ToolTipService.ToolTip="调试模式已启用：任务完成后将保留临时音频与中间文件">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEBE8;" FontSize="11" Foreground="#856404" />
                        <TextBlock x:Name="DebugModeBadgeText" Text="调试模式" FontSize="11" FontWeight="SemiBold" Foreground="#856404" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: Action Buttons (Clear Completed & Settings) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="ClearCompletedBtn" Click="OnClearCompletedClicked" ToolTipService.ToolTip="清除已完成任务">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock x:Name="ClearCompletedLabel" Text="清除已完成" />
                    </StackPanel>
                </Button>

                <Button x:Name="SettingsBtn"
                        Click="OnSettingsClicked"
                        RightTapped="OnSettingsRightTapped"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="打开设置中心 (连续右键3次切换调试模式)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock x:Name="SettingsLabel" Text="设置" />
                    </StackPanel>
                </Button>

                <TeachingTip x:Name="DebugModeTip"
                             Target="{x:Bind SettingsBtn}"
                             PreferredPlacement="Bottom"
                             IsLightDismissEnabled="True" />
            </StackPanel>
        </Grid>

        <!-- Minimalist Drop Zone & Import Trigger (Taller & Prominent) -->
        <Border Grid.Row="1"
                x:Name="DropZoneBorder"
                CornerRadius="10"
                Margin="0,0,0,16"
                Padding="24,36"
                MinHeight="220"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                BorderThickness="1.5">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <FontIcon Grid.Row="0" Glyph="&#xE898;" FontSize="44" Margin="0,0,0,12" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,16">
                    <TextBlock x:Name="DropTitleBlock" Text="拖拽视频或文件夹到此处"
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Import Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button x:Name="ImportVideosBtn" Click="OnImportVideosClicked" Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="16" />
                            <TextBlock x:Name="ImportVideosLabel" Text="导入视频" FontWeight="Medium" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ImportFolderBtn" Click="OnImportFolderClicked" Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xED25;" FontSize="16" />
                            <TextBlock x:Name="ImportFolderLabel" Text="导入文件夹" FontWeight="Medium" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video Queue Area (Original UI) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Queue Header -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="QueueTitleBlock" Text="处理队列" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="QueueCountBlock" Text="0" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Empty Queue Placeholder -->
            <Border Grid.Row="1" x:Name="EmptyQueuePanel"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="32"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xEA37;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyQueueHintBlock" Text="暂无任务，请点击上方按钮或直接拖入视频"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Tasks ListView -->
            <ListView Grid.Row="1"
                      x:Name="TasksListView"
                      SelectionMode="None"
                      Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VideoTaskItem">
                        <Border CornerRadius="8"
                                Padding="16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon, File Name, Size, and Action -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Video Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                            Margin="0,0,12,0">
                                        <FontIcon Glyph="&#xE714;" FontSize="18" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                    </Border>

                                    <!-- File Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FileSizeFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Status & Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Open Folder Link on Completed -->
                                        <Button Visibility="{x:Bind IsCompleted, Mode=OneWay}"
                                                Click="OnOpenFolderClicked"
                                                Tag="{x:Bind}"
                                                Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                                <TextBlock Text="{x:Bind OpenText}" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Retry Button on Failed -->
                                        <Button Visibility="{x:Bind IsFailed, Mode=OneWay}"
                                                Click="OnRetryClicked"
                                                Tag="{x:Bind}"
                                                Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                <TextBlock Text="{x:Bind RetryText}" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Cancel Button on Waiting or Running -->
                                        <Button Visibility="{x:Bind CanCancel, Mode=OneWay}"
                                                Click="OnCancelClicked"
                                                Tag="{x:Bind}"
                                                Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind CancelText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress Bar (Determinate: fixes flashing & looping bug) -->
                                <ProgressBar Grid.Row="1"
                                             Value="{x:Bind Progress, Mode=OneWay}"
                                             Maximum="100"
                                             IsIndeterminate="False"
                                             Margin="0,0,0,6" />

                                <!-- Status Text, Elapsed Time & Percentage -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Text & Failure Error Message -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Visibility="{x:Bind IsFailed, Mode=OneWay}"
                                                   Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="#E81123"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Elapsed Time & Progress Percentage -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ShowElapsedTime, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedElapsedTime, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ProgressPercentText, Mode=OneWay}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
